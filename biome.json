{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!node_modules", "!.next", "!dist", "!build", "!drizzle"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noLabelWithoutControl": {
          "level": "error",
          "options": {
            "inputComponents": ["Input", "FilterSearch", "FilterSelect"]
          }
        }
      },
      "correctness": {
        "noUnusedImports": "error"
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/app/**/launch/_components/field.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "useHookAtTopLevel": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/components/math-html.tsx",
        "src/app/**/launch/_components/json-ld.tsx"
      ],
      "linter": {
        "rules": {
          "security": {
            "noDangerouslySetInnerHtml": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/lib/**",
        "src/db/**",
        "src/server/**",
        "src/components/**",
        "src/i18n/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/features/**", "@/app/**"],
                    "message": "lib, db, server and components sit below features and never import them."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/catalog/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/features/**", "!@/features/catalog/**"],
                    "message": "catalog imports no other feature; features form a DAG."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/progress/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/features/**",
                      "!@/features/progress/**",
                      "!@/features/catalog/**"
                    ],
                    "message": "progress imports only catalog; features form a DAG."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/practice/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/features/**",
                      "!@/features/practice/**",
                      "!@/features/catalog/**",
                      "!@/features/progress/**"
                    ],
                    "message": "practice imports only catalog, progress; features form a DAG."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/variants/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/features/**",
                      "!@/features/variants/**",
                      "!@/features/catalog/**"
                    ],
                    "message": "variants imports only catalog; features form a DAG."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/tests/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/features/**",
                      "!@/features/tests/**",
                      "!@/features/catalog/**",
                      "!@/features/progress/**",
                      "!@/features/practice/**",
                      "!@/features/variants/**"
                    ],
                    "message": "tests imports only catalog, progress, practice, variants; features form a DAG."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/bank/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/features/**",
                      "!@/features/bank/**",
                      "!@/features/catalog/**",
                      "!@/features/progress/**",
                      "!@/features/practice/**"
                    ],
                    "message": "bank imports only catalog, progress, practice; features form a DAG."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/theory/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/features/**",
                      "!@/features/theory/**",
                      "!@/features/catalog/**"
                    ],
                    "message": "theory imports only catalog; features form a DAG."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/account/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/features/**",
                      "!@/features/account/**",
                      "!@/features/tests/**"
                    ],
                    "message": "account imports only tests; features form a DAG."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/launch/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/features/**", "!@/features/launch/**"],
                    "message": "launch imports no other feature; features form a DAG."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/app/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@/server/db": "Pages, route handlers and actions call feature functions and never query the database.",
                  "@/db/schema": "Pages, route handlers and actions call feature functions and never query the database.",
                  "drizzle-orm": "Pages, route handlers and actions call feature functions and never query the database."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/progress/actions.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/features/**",
                      "!@/features/progress/**",
                      "!@/features/catalog/**"
                    ],
                    "message": "progress imports only catalog; features form a DAG."
                  }
                ],
                "paths": {
                  "@/server/db": "Pages, route handlers and actions call feature functions and never query the database.",
                  "@/db/schema": "Pages, route handlers and actions call feature functions and never query the database.",
                  "drizzle-orm": "Pages, route handlers and actions call feature functions and never query the database."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/practice/actions.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/features/**",
                      "!@/features/practice/**",
                      "!@/features/catalog/**",
                      "!@/features/progress/**"
                    ],
                    "message": "practice imports only catalog, progress; features form a DAG."
                  }
                ],
                "paths": {
                  "@/server/db": "Pages, route handlers and actions call feature functions and never query the database.",
                  "@/db/schema": "Pages, route handlers and actions call feature functions and never query the database.",
                  "drizzle-orm": "Pages, route handlers and actions call feature functions and never query the database."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/tests/actions.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/features/**",
                      "!@/features/tests/**",
                      "!@/features/catalog/**",
                      "!@/features/progress/**",
                      "!@/features/practice/**",
                      "!@/features/variants/**"
                    ],
                    "message": "tests imports only catalog, progress, practice, variants; features form a DAG."
                  }
                ],
                "paths": {
                  "@/server/db": "Pages, route handlers and actions call feature functions and never query the database.",
                  "@/db/schema": "Pages, route handlers and actions call feature functions and never query the database.",
                  "drizzle-orm": "Pages, route handlers and actions call feature functions and never query the database."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/account/actions.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/features/**",
                      "!@/features/account/**",
                      "!@/features/tests/**"
                    ],
                    "message": "account imports only tests; features form a DAG."
                  }
                ],
                "paths": {
                  "@/server/db": "Pages, route handlers and actions call feature functions and never query the database.",
                  "@/db/schema": "Pages, route handlers and actions call feature functions and never query the database.",
                  "drizzle-orm": "Pages, route handlers and actions call feature functions and never query the database."
                }
              }
            }
          }
        }
      }
    }
  ]
}
