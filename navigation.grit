language js

or {
  or {
    JsImportDefaultClause(source=$s),
    JsImportCombinedClause(source=$s)
  } where { $s <: r"['\"]next/link['\"]" },
  or {
    JsImportNamedClause(source=$s, named_specifiers=$names),
    JsImportCombinedClause(source=$s, specifier=$names),
    JsExportNamedFromClause(source=$s, specifiers=$names)
  } where {
    $s <: r"['\"]next/navigation['\"]",
    $names <: contains or {
      r"redirect",
      r"permanentRedirect"
    }
  },
  or {
    JsImportNamespaceClause(source=$s),
    JsExportFromClause(source=$s)
  } where { $s <: r"['\"]next/navigation['\"]" },
  or {
    JsImportNamedClause(source=$s),
    JsImportDefaultClause(source=$s),
    JsImportNamespaceClause(source=$s),
    JsImportCombinedClause(source=$s),
    JsExportNamedFromClause(source=$s),
    JsExportFromClause(source=$s)
  } where {
    $s <: r"['\"]next-intl/navigation['\"]",
    $filename <: not r".*src/i18n/.*"
  }
} as $import where {
  register_diagnostic(span=$import, message="Import Link, redirect, permanentRedirect and next-intl navigation from @/i18n/navigation.")
}
