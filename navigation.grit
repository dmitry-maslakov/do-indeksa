language js

or {
  or {
    JsImportDefaultClause(source=$s),
    JsImportCombinedClause(source=$s)
  } where { $s <: r"['\"]next/link['\"]" },
  or {
    JsImportNamedClause(source=$s, named_specifiers=$names),
    JsImportCombinedClause(source=$s, specifier=$names),
    JsExportNamedFromClause(source=$s, specifiers=$names)
  } where {
    $s <: r"['\"]next/navigation['\"]",
    $names <: contains or {
      r"redirect",
      r"permanentRedirect"
    }
  },
  or {
    JsImportNamespaceClause(source=$s),
    JsExportFromClause(source=$s)
  } where { $s <: r"['\"]next/navigation['\"]" }
} as $import where {
  register_diagnostic(span=$import, message="Import Link, redirect and permanentRedirect from @/i18n/navigation.")
}
